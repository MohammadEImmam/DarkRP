@using Sandbox;
@using Sandbox.Utility
@namespace Sandbox
@using System.Globalization
@using System.Text
@inherits PanelComponent

<root>

    <div class="output">
        @foreach (var entry in _entries)
        {
            <div class="chat_entry">
                @if (entry.SteamId > 0)
                {
                    <div class="avatar" style="@GetAvatarStyle(entry.SteamId)"></div>
                }
                <div class="author">@entry.Author</div>
                @if (!string.IsNullOrWhiteSpace(entry.Tag))
                {
                    <div class="tag" style="@entry.TagStyle">@entry.Tag</div>
                }
                <div class="message" style="@entry.MessageStyle">@entry.Message</div>
            </div>
        }
    </div>

    <div class="input">
        <TextEntry @ref="InputBox" onsubmit="@ChatFinished"></TextEntry>
        @if (Suggestions.Count > 0)
        {
            <div class="command_preview">
                @foreach (var suggestion in Suggestions)
                {
                    <div class="command_suggestion">
                        <div class="command_usage">@suggestion.Usage</div>
                        <div class="command_description">@suggestion.Description</div>
                        @if (!string.IsNullOrWhiteSpace(suggestion.AccessText))
                        {
                            <div class="command_access">@suggestion.AccessText</div>
                        }
                    </div>
                }
            </div>
        }
        <TextEntry @ref="_inputBox" @onsubmit="@ChatFinished"></TextEntry>
    </div>

</root>

@code
{
    TextEntry InputBox = default;
    string LastInputText = "";
    bool LastInputFocused;

    public record Entry( ulong steamid, string author, string message, RealTimeSince timeSinceAdded );
    List<Entry> Entries = new();
    List<ChatCommandPreview> Suggestions = new();
    TextEntry _inputBox;
    static readonly HashSet<string> BypassedCommandNames = new(StringComparer.OrdinalIgnoreCase) { "name", "drop", "ban", "kick" };

    public record Entry( ulong SteamId, string Author, string Message, string Tag, string TagStyle, string MessageStyle, RealTimeSince TimeSinceAdded );
    List<Entry> _entries = new();

    protected override void OnUpdate()
    {
        if (_inputBox is null)
            return;

        Panel.AcceptsFocus = false;

        if ( Input.Pressed( "chat" ) )
        {
            _inputBox.Focus();
        }

        UpdateCommandSuggestions();

        if ( Entries.RemoveAll( x => x.timeSinceAdded > 20.0f ) > 0 )
        if ( _entries.RemoveAll( x => x.TimeSinceAdded > 20.0f ) > 0 )
        {
            StateHasChanged();
        }

        SetClass( "open", _inputBox.HasFocus );
        SetClass( "hide", Player.FindLocalPlayer()?.WantsHideHud ?? false );
    }

    static string GetAvatarStyle( ulong steamId ) => $"background-image: url('avatar:{steamId}');";

    void ChatFinished()
    {
        var text = InputBox.Text;
        InputBox.Text = "";
        Suggestions.Clear();
        LastInputText = "";
        LastInputFocused = false;
        var text = _inputBox.Text;
        _inputBox.Text = "";

        if (string.IsNullOrWhiteSpace(text))
            return;

        if (ChatCommandSystem.IsCommandInput(text))
        {
            RequestRunCommand(text);
            StateHasChanged();
            return;
        if ( text.Contains( "colmore", StringComparison.OrdinalIgnoreCase ) )
        {
            Services.Stats.Increment( "secret_phrase", 1 );
        }

        AddText( text );
    }

    void UpdateCommandSuggestions()
    {
        var text = InputBox.Text ?? "";
        var focused = InputBox.HasFocus;
        if (text == LastInputText && focused == LastInputFocused)
            return;

        LastInputText = text;
        LastInputFocused = focused;
        Suggestions = focused
            ? ChatCommandSystem.GetPreviews(text, Player.FindLocalPlayer()).ToList()
            : new();
        StateHasChanged();
    }

	[Rpc.Host]
    public void RequestRunCommand( string message )
    {
        message = message.Truncate(300);

        if (string.IsNullOrWhiteSpace(message))
            return;

        ChatCommandSystem.TryExecute(Rpc.Caller, message);
    }

    [ConCmd( "say" )]
    private static void Say( string msg )
    {
       var chat = Game.ActiveScene.GetAll<Chat>()
                                .FirstOrDefault();

       if ( chat is null )
           return;

       if ( Application.IsDedicatedServer )
       {
           chat.AddSystemText( msg );
       }
       else
       {
           chat.AddText( msg );
       }
    }

	[Rpc.Broadcast]
    private void AddText( string message )
    {
        if ( !Networking.IsHost )
            return;

        message = message.Truncate( 300 );
        message = message?.Trim();

        if (string.IsNullOrWhiteSpace(message))
            return;

        var source = Rpc.Caller;
        if ( source is null )
            return;

        if ( TryHandleBypassedCommand( source, message ) )
            return;

        if ( TryParsePrefixedCommand( message, out var token, out var payload ) )
        {
            var definition = ChatCommandDefinition.FindForToken( token );
            if ( definition is not null )
            {
                if ( string.IsNullOrWhiteSpace( payload ) )
                    return;

                BroadcastPlayerText(
                    source,
                    payload,
                    definition.Tag,
                    BuildStyleString( definition.TagColor, definition.TagFont, definition.TagBold, definition.TagItalic ),
                    BuildStyleString( definition.MessageColor, definition.MessageFont, definition.MessageBold, definition.MessageItalic )
                );
                return;
            }
        }

        BroadcastPlayerText( source, message, null, null, null );
    }

    private bool TryHandleBypassedCommand( Connection source, string message )
    {
        if ( !TryParsePrefixedCommand( message, out var token, out var payload ) )
            return false;

        var commandName = token[1..];
        if ( !BypassedCommandNames.Contains( commandName ) )
            return false;

        var player = Player.FindForConnection( source );

        switch ( commandName )
        {
            case "name":
                if ( !string.IsNullOrWhiteSpace( payload ) )
                    player?.RequestSetRoleplayName( payload );
                return true;

            case "drop":
                if ( int.TryParse( payload, out var amount ) )
                    player?.RequestDropMoney( amount );
                return true;

            case "kick":
                return TryRunKickBypass( player, payload );

            case "ban":
                return TryRunBanBypass( player, payload );
        }

        return true;
    }

    static bool TryRunKickBypass( Player player, string payload )
    {
        if ( !TrySplitTargetAndReason( payload, out var target, out var reason ) )
            return true;

        var connection = ResolveConnection( target );
        if ( connection is null )
            return true;

        player?.RequestKickPlayer( connection.SteamId.Value, reason );
        return true;
    }

    static bool TryRunBanBypass( Player player, string payload )
    {
        if ( !TrySplitTargetAndReason( payload, out var target, out var reason ) )
            return true;

        var connection = ResolveConnection( target );
        if ( connection is null )
            return true;

        player?.RequestBanPlayer( connection.SteamId.Value, reason );
        return true;
    }

    static Connection ResolveConnection( string target )
    {
        if ( string.IsNullOrWhiteSpace( target ) )
            return null;

        if ( ulong.TryParse( target.Trim(), out var steamId ) )
            return Connection.All.FirstOrDefault( x => x.SteamId == steamId );

        return GameManager.FindPlayerWithName( target.Trim() );
    }

    static bool TrySplitTargetAndReason( string payload, out string target, out string reason )
    {
        target = null;
        reason = null;

        if ( string.IsNullOrWhiteSpace( payload ) )
            return false;

        var trimmed = payload.Trim();
        var splitIndex = trimmed.IndexOf( ' ' );
        if ( splitIndex < 0 )
        {
            target = trimmed;
            return true;
        }

        target = trimmed[..splitIndex];
        reason = trimmed[(splitIndex + 1)..].Trim();
        return true;
    }

    static bool TryParsePrefixedCommand( string message, out string token, out string payload )
    {
        token = null;
        payload = null;

        if ( string.IsNullOrWhiteSpace( message ) )
            return false;

        var trimmed = message.Trim();
        if ( trimmed.Length < 2 )
            return false;

        var prefix = trimmed[0];
        if ( prefix is not ('/' or '!') )
            return false;

        var splitIndex = trimmed.IndexOf( ' ' );
        token = splitIndex < 0 ? trimmed : trimmed[..splitIndex];
        token = token.ToLowerInvariant();
        payload = splitIndex < 0 ? string.Empty : trimmed[(splitIndex + 1)..].Trim();
        return true;
    }

    private void BroadcastPlayerText( Connection source, string message, string tag, string tagStyle, string messageStyle )
    {
        if ( source is null )
            return;

        var author = source.DisplayName;
        var steamid = source.SteamId;

		Log.Info($"{author}: {message}");

        var filteredName = Steam.FilterName(author, steamid);
        message = Steam.FilterChat(message, steamid);

        ReceivePlayerText( steamid, filteredName, message, tag, tagStyle, messageStyle );
    }

	[Rpc.Broadcast( NetFlags.HostOnly )]
    private void ReceivePlayerText( ulong steamid, string author, string message, string tag, string tagStyle, string messageStyle )
    {
        if ( string.IsNullOrWhiteSpace( message ) )
            return;

        _entries.Add(new Entry(steamid, author, message, tag, tagStyle, messageStyle, 0.0f));
		StateHasChanged();
	}

    static string BuildStyleString( Color color, string font, bool bold, bool italic )
    {
        var builder = new StringBuilder();
        var r = Math.Clamp( (int)(color.r * 255f), 0, 255 );
        var g = Math.Clamp( (int)(color.g * 255f), 0, 255 );
        var b = Math.Clamp( (int)(color.b * 255f), 0, 255 );
        var a = Math.Clamp( color.a, 0f, 1f );

        builder.Append( $"color: rgba({r}, {g}, {b}, {a.ToString( "0.###", CultureInfo.InvariantCulture )});" );

        if ( !string.IsNullOrWhiteSpace( font ) )
        {
            var sanitizedFont = font.Replace( "\"", "" );
            builder.Append( $"font-family: '{sanitizedFont}';" );
        }

        builder.Append( bold ? "font-weight: 700;" : "font-weight: 500;" );
        builder.Append( italic ? "font-style: italic;" : "font-style: normal;" );
        return builder.ToString();
    }

	[Rpc.Broadcast( NetFlags.HostOnly )]
    public void AddSystemText( string message, string icon = "ℹ️" )
    {
        message = message.Truncate(300);

        if (string.IsNullOrWhiteSpace(message))
            return;

        _entries.Add(new Entry(0, icon, message, null, null, null, 0.0f));
        StateHasChanged();
    }

    public void AddSystemTextTo( Connection target, string message, string icon = "ℹ️" )
    {
        if (!Networking.IsHost || target is null)
            return;

        using (Rpc.FilterInclude(target))
        {
            AddSystemText(message, icon);
        }
    }

}
